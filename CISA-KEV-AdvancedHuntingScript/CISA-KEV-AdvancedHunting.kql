// =============================================================================
// --- QUERY 3: CISA KEV summary — overdue + ransomware risk ------------------
// Quick executive view: how many KEVs, how many overdue, ransomware exposure.
// =============================================================================
/*
let CISA_KEV = externaldata(
    cveID: string,
    vendorProject: string,
    product: string,
    vulnerabilityName: string,
    dateAdded: datetime,
    shortDescription: string,
    requiredAction: string,
    dueDate: datetime,
    knownRansomwareCampaignUse: string,
    notes: string,
    cwes: string
)
[@"https://www.cisa.gov/sites/default/files/csv/known_exploited_vulnerabilities.csv"]
with (format="csv", ignoreFirstRecord=true);
CISA_KEV
| project CveId=cveID, dueDate, knownRansomwareCampaignUse
| join kind=inner hint.strategy=broadcast (
    DeviceTvmSoftwareVulnerabilities
    | project DeviceName, CveId
) on CveId
| extend IsOverdue = dueDate < now()
| extend IsRansomware = knownRansomwareCampaignUse != "Unknown"
| summarize
    TotalKEVFindings = count(),
    UniqueKEVs = dcount(CveId),
    AffectedDevices = dcount(DeviceName),
    OverdueFindings = countif(IsOverdue),
    RansomwareLinkedKEVs = dcountif(CveId, IsRansomware),
    RansomwareAffectedDevices = dcountif(DeviceName, IsRansomware),
    OldestDueDatePast = min(iff(IsOverdue, dueDate, datetime(null))),
    NextDueDate = min(iff(not(IsOverdue), dueDate, datetime(null)))
*/


// =============================================================================
// --- QUERY 4: Devices with the most CISA KEV exposure -----------------------
// Ranks devices by total KEV count — find your highest-risk machines.
// =============================================================================
/*
let CISA_KEV = externaldata(
    cveID: string,
    vendorProject: string,
    product: string,
    vulnerabilityName: string,
    dateAdded: datetime,
    shortDescription: string,
    requiredAction: string,
    dueDate: datetime,
    knownRansomwareCampaignUse: string,
    notes: string,
    cwes: string
)
[@"https://www.cisa.gov/sites/default/files/csv/known_exploited_vulnerabilities.csv"]
with (format="csv", ignoreFirstRecord=true);
CISA_KEV
| project CveId=cveID, dueDate, knownRansomwareCampaignUse
| join kind=inner hint.strategy=broadcast (
    DeviceTvmSoftwareVulnerabilities
    | project DeviceName, DeviceId, CveId, OSPlatform, OSVersion
) on CveId
| extend IsOverdue = dueDate < now()
| extend IsRansomware = knownRansomwareCampaignUse != "Unknown"
| summarize
    KEVCount = dcount(CveId),
    OverdueCount = dcountif(CveId, IsOverdue),
    RansomwareCount = dcountif(CveId, IsRansomware),
    KEVList = make_set(CveId, 20)
    by DeviceName, DeviceId, OSPlatform, OSVersion
| sort by KEVCount desc
| take 50
*/
