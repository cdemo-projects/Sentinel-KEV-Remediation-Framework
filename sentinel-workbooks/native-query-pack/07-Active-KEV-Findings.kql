// Recreates the workbook Active KEV findings table.
// Empty selection arrays include all values.
// Drafting assistance: Claude Opus 4.8 (via GitHub Copilot), grounded in official Microsoft Learn documentation.

let SelectedDevices = dynamic([]);
let SelectedCveIds = dynamic([]);
let SelectedVulnerabilityNames = dynamic([]);
let SelectedVendors = dynamic([]);
let SelectedProducts = dynamic([]);
let CISA_KEV = externaldata(
    cveID: string,
    vendorProject: string,
    product: string,
    vulnerabilityName: string,
    dateAdded: datetime,
    shortDescription: string,
    requiredAction: string,
    dueDate: datetime,
    knownRansomwareCampaignUse: string,
    notes: string,
    cwes: string
)
[@"https://www.cisa.gov/sites/default/files/csv/known_exploited_vulnerabilities.csv"]
with (format="csv", ignoreFirstRecord=true);
CISA_KEV
| where array_length(SelectedVulnerabilityNames) == 0
    or set_has_element(SelectedVulnerabilityNames, vulnerabilityName)
| where array_length(SelectedVendors) == 0
    or set_has_element(SelectedVendors, vendorProject)
| where array_length(SelectedProducts) == 0
    or set_has_element(SelectedProducts, product)
| project
    CveId = cveID,
    vulnerabilityName,
    shortDescription,
    vendorProject,
    product,
    dueDate,
    knownRansomwareCampaignUse
| join kind=inner hint.strategy=broadcast (
    DeviceTvmSoftwareVulnerabilities
    | where array_length(SelectedDevices) == 0
        or set_has_element(SelectedDevices, DeviceName)
    | where array_length(SelectedCveIds) == 0
        or set_has_element(SelectedCveIds, CveId)
    | project
        DeviceName,
        CveId,
        SoftwareName,
        SoftwareVersion,
        VulnerabilitySeverityLevel,
        RecommendedSecurityUpdate,
        RecommendedSecurityUpdateId
) on CveId
| extend
    DaysUntilDue = datetime_diff("day", dueDate, now()),
    SecurityUpdateAvailable =
        isnotempty(RecommendedSecurityUpdateId)
        or isnotempty(RecommendedSecurityUpdate)
| extend
    DueStatus = case(
        DaysUntilDue < 0, "Past Due",
        DaysUntilDue < 14, "Due < 14d",
        "Due > 14d"
    ),
    SeverityRank = case(
        VulnerabilitySeverityLevel == "Critical", 4,
        VulnerabilitySeverityLevel == "High", 3,
        VulnerabilitySeverityLevel == "Medium", 2,
        VulnerabilitySeverityLevel == "Low", 1,
        0
    )
| order by DueStatus asc, SeverityRank desc
| project
    ['Device Name'] = DeviceName,
    ['CVE ID'] = CveId,
    Vulnerability = vulnerabilityName,
    Description = shortDescription,
    Vendor = vendorProject,
    Product = product,
    Software = SoftwareName,
    Version = SoftwareVersion,
    Severity = VulnerabilitySeverityLevel,
    ['Ransomware Use'] = knownRansomwareCampaignUse,
    ['Due Date'] = dueDate,
    ['Due Status'] = DueStatus,
    ['Recommended Update'] = RecommendedSecurityUpdate,
    ['Update Available'] = SecurityUpdateAvailable
